{
  "name": "@personal-erp/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint src test --config ../eslint.config.mjs --max-warnings 0",
    "prisma:format": "dotenv -e ../.env -- prisma format --schema prisma/schema.prisma",
    "prisma:generate": "dotenv -e ../.env -- prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:validate": "dotenv -e ../.env -- prisma validate --schema prisma/schema.prisma",
    "start": "node dist/main.js",
    "test": "jest --runInBand --config jest.config.cjs",
    "test:e2e": "dotenv -e ../.env -- jest --runInBand --config jest.e2e.config.cjs",
    "test:integration": "dotenv -e ../.env -- jest --runInBand --config jest.integration.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-node": "5.4.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
