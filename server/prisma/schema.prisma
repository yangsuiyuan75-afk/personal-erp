generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MasterDataStatus {
  ACTIVE
  INACTIVE
}

enum ChannelInventoryMode {
  DIRECT_FROM_LOCATION
  EXTERNAL_WAREHOUSE
  VIRTUAL_ALLOCATION
}

enum InventoryStockStatus {
  AVAILABLE
  QC_PENDING
  DEFECTIVE
  SUPPLIER_CLAIM
  SCRAPPED
}

enum InventoryLocationType {
  PHYSICAL_WAREHOUSE
  EXTERNAL_WAREHOUSE
  QC_AREA
  DEFECTIVE_AREA
  CLAIM_AREA
  SCRAP_AREA
}

enum InventoryTransactionType {
  OPENING_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALES_ISSUE
  SALES_RETURN_QC
  QC_RELEASE
  QC_DEFECTIVE
  QC_CLAIM
  SCRAP
  SUPPLIER_REPLACEMENT
  REVERSAL
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AdjustmentDirection {
  IN
  OUT
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  SETTLED
  VOID
}

enum SupplierCreditStatus {
  OPEN
  PARTIALLY_APPLIED
  APPLIED
  VOID
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_ISSUED
  ISSUED
  CANCELLED
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_RECEIVED
  SETTLED
  VOID
}

enum CustomerRefundStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum QualityResponsibility {
  UNKNOWN
  SUPPLIER
  CUSTOMER
  LOGISTICS
  INTERNAL
}

enum QualityInspectionStatus {
  DRAFT
  CONFIRMED
}

enum QualityIssueStatus {
  OPEN
  CLAIMED
  RESOLVED
  CLOSED
}

enum SupplierClaimStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_SETTLED
  SETTLED
  REJECTED
  CLOSED
}

enum ClaimResolutionType {
  REPLACEMENT
  CASH_COMPENSATION
  CREDIT_COMPENSATION
  REJECTED
  SELF_BEAR
  SCRAP
}

enum FinancialAccountType {
  BANK
  ALIPAY
  PAYPAL
  PLATFORM_BALANCE
  CASH
  OTHER
}

enum FinancialDirection {
  IN
  OUT
}

enum FinancialTransactionCategory {
  SALES_RECEIPT
  SUPPLIER_COMPENSATION
  PURCHASE_PAYMENT
  CUSTOMER_REFUND
  PLATFORM_FEE
  LOGISTICS_FEE
  OTHER_INCOME
  OTHER_EXPENSE
  ACCOUNT_ADJUSTMENT
}

enum StorageProviderType {
  ONEDRIVE
  MOCK_LOCAL
}

enum FileAssetStatus {
  PENDING
  UPLOADING
  SYNCED
  FAILED
  DELETED
}

enum BackupStatus {
  CREATING
  UPLOADING
  VERIFIED
  FAILED
  EXPIRED
}

enum BackupFormat {
  POSTGRES_CUSTOM
}

enum BackupTrigger {
  MANUAL
  STARTUP_COMPENSATION
  OPERATION_THRESHOLD
  PRE_RESTORE
  BOOTSTRAP_IMPORT
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id              String           @id @default(uuid()) @db.Uuid
  username        String           @unique
  passwordHash    String
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]
  backups         BackupHistory[]
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         BigInt     @id @default(autoincrement())
  userId     String?    @db.Uuid
  module     String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  result     String
  requestId  String?
  createdAt  DateTime   @default(now())
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, action, createdAt])
  @@index([entityType, entityId])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  requestHash  String
  responseJson Json
  statusCode   Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

model Category {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  name      String
  status    MasterDataStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  products  Product[]

  @@index([status, createdAt])
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  categoryId  String           @db.Uuid
  name        String
  brand       String?
  description String?
  status      MasterDataStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  skus        Sku[]
  images      ProductImage[]

  @@index([categoryId, status, createdAt])
}

model Unit {
  id           String           @id @default(uuid()) @db.Uuid
  code         String           @unique
  name         String
  decimalScale Int              @default(0) @db.SmallInt
  status       MasterDataStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  skus         Sku[]

  @@index([status, createdAt])
}

model Sku {
  id                     String                     @id @default(uuid()) @db.Uuid
  code                   String                     @unique
  barcode                String?                    @unique
  productId              String                     @db.Uuid
  baseUnitId             String                     @db.Uuid
  name                   String
  attributes             Json                       @default("{}")
  weight                 Decimal?                   @db.Decimal(18, 4)
  status                 MasterDataStatus           @default(ACTIVE)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  product                Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  baseUnit               Unit                       @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  inventoryBalances      InventoryBalance[]
  inventoryLines         InventoryTransactionLine[]
  inventoryBatches       InventoryBatch[]
  openingItems           InventoryOpeningItem[]
  adjustmentItems        InventoryAdjustmentItem[]
  transferItems          InventoryTransferItem[]
  channelAllocationItems ChannelAllocationItem[]
  purchasePrices         PurchasePrice[]
  purchaseOrderItems     PurchaseOrderItem[]
  purchaseReceiptItems   PurchaseReceiptItem[]
  purchaseReturnItems    PurchaseReturnItem[]
  salesPrices            SalesPrice[]
  salesOrderItems        SalesOrderItem[]
  salesIssueItems        SalesIssueItem[]
  salesReturnItems       SalesReturnItem[]
  qualityIssues          QualityIssue[]

  @@index([productId, status, createdAt])
  @@map("SKU")
}

model PurchaseChannel {
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique
  name                  String
  type                  String
  status                MasterDataStatus       @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  suppliers             Supplier[]
  buyers                BuyerPurchaseChannel[]
  purchasePrices        PurchasePrice[]
  purchaseOrders        PurchaseOrder[]
  payables              Payable[]
  payments              Payment[]
  adjustments           AccountAdjustment[]
  financialTransactions FinancialTransaction[]

  @@index([status, createdAt])
}

model Supplier {
  id                      String                           @id @default(uuid()) @db.Uuid
  code                    String                           @unique
  name                    String
  contactName             String?
  phone                   String?
  taxNo                   String?
  purchaseChannelId       String?                          @db.Uuid
  status                  MasterDataStatus                 @default(ACTIVE)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  purchaseChannel         PurchaseChannel?                 @relation(fields: [purchaseChannelId], references: [id], onDelete: Restrict)
  inventoryBatches        InventoryBatch[]
  purchasePrices          PurchasePrice[]
  purchaseOrders          PurchaseOrder[]
  purchaseReturns         PurchaseReturn[]
  payables                Payable[]
  supplierCredits         SupplierCredit[]
  qualityIssues           QualityIssue[]
  supplierClaims          SupplierClaim[]
  compensationReceivables SupplierCompensationReceivable[]
  payments                Payment[]
  receipts                Receipt[]
  adjustments             AccountAdjustment[]
  financialTransactions   FinancialTransaction[]

  @@index([purchaseChannelId, status, createdAt])
}

model Buyer {
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique
  name                  String
  phone                 String?
  status                MasterDataStatus       @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  channels              BuyerPurchaseChannel[]
  purchasePrices        PurchasePrice[]
  purchaseOrders        PurchaseOrder[]
  payables              Payable[]
  payments              Payment[]
  adjustments           AccountAdjustment[]
  financialTransactions FinancialTransaction[]

  @@index([status, createdAt])
}

model BuyerPurchaseChannel {
  buyerId           String          @db.Uuid
  purchaseChannelId String          @db.Uuid
  buyer             Buyer           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  purchaseChannel   PurchaseChannel @relation(fields: [purchaseChannelId], references: [id], onDelete: Restrict)

  @@id([buyerId, purchaseChannelId])
}

model SalesChannel {
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique
  name                  String
  inventoryMode         ChannelInventoryMode
  defaultLocationId     String?                @db.Uuid
  status                MasterDataStatus       @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customers             Customer[]
  defaultLocation       InventoryLocation?     @relation("DefaultSalesChannelLocation", fields: [defaultLocationId], references: [id], onDelete: Restrict)
  inventoryLocations    InventoryLocation[]    @relation("SalesChannelLocations")
  channelAllocations    ChannelAllocation[]
  salesPrices           SalesPrice[]
  salesOrders           SalesOrder[]
  salesIssues           SalesIssue[]
  salesReturns          SalesReturn[]
  receivables           Receivable[]
  customerRefunds       CustomerRefund[]
  payments              Payment[]
  receipts              Receipt[]
  adjustments           AccountAdjustment[]
  financialTransactions FinancialTransaction[]

  @@index([status, createdAt])
}

model InventoryLocation {
  id                      String                     @id @default(uuid()) @db.Uuid
  code                    String                     @unique
  name                    String
  type                    InventoryLocationType
  parentId                String?                    @db.Uuid
  salesChannelId          String?                    @db.Uuid
  isLeaf                  Boolean                    @default(true)
  status                  MasterDataStatus           @default(ACTIVE)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  parent                  InventoryLocation?         @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                InventoryLocation[]        @relation("LocationTree")
  salesChannel            SalesChannel?              @relation("SalesChannelLocations", fields: [salesChannelId], references: [id], onDelete: Restrict)
  defaultForSalesChannels SalesChannel[]             @relation("DefaultSalesChannelLocation")
  balances                InventoryBalance[]
  transactionLines        InventoryTransactionLine[]
  openingItems            InventoryOpeningItem[]
  adjustmentItems         InventoryAdjustmentItem[]
  transfersFrom           InventoryTransfer[]        @relation("TransferFrom")
  transfersTo             InventoryTransfer[]        @relation("TransferTo")
  channelAllocations      ChannelAllocation[]
  purchaseReceipts        PurchaseReceipt[]
  purchaseReturns         PurchaseReturn[]
  salesIssues             SalesIssue[]
  salesReturns            SalesReturn[]
  replacementSettlements  SupplierClaimSettlement[]  @relation("ReplacementLocation")
  claimStockSettlements   SupplierClaimSettlement[]  @relation("ClaimStockLocation")
  scrapSettlements        SupplierClaimSettlement[]  @relation("SettlementScrapLocation")

  @@index([type, status, createdAt])
  @@index([salesChannelId, status])
}

model InventoryBalance {
  locationId       String               @db.Uuid
  skuId            String               @db.Uuid
  stockStatus      InventoryStockStatus
  onHandQuantity   Decimal              @default(0) @db.Decimal(18, 4)
  reservedQuantity Decimal              @default(0) @db.Decimal(18, 4)
  averageCost      Decimal              @default(0) @db.Decimal(18, 6)
  inventoryValue   Decimal              @default(0) @db.Decimal(30, 4)
  version          Int                  @default(0)
  updatedAt        DateTime             @updatedAt
  location         InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sku              Sku                  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@id([locationId, skuId, stockStatus])
  @@index([skuId, stockStatus, updatedAt])
  @@index([locationId, stockStatus, updatedAt])
}

model InventoryTransaction {
  id                    String                     @id @default(uuid()) @db.Uuid
  transactionNo         String                     @unique
  type                  InventoryTransactionType
  occurredAt            DateTime
  sourceType            String
  sourceId              String
  idempotencyKey        String                     @unique
  reversedTransactionId String?                    @unique @db.Uuid
  postedAt              DateTime                   @default(now())
  createdAt             DateTime                   @default(now())
  reversedTransaction   InventoryTransaction?      @relation("InventoryReversal", fields: [reversedTransactionId], references: [id], onDelete: Restrict)
  reversal              InventoryTransaction?      @relation("InventoryReversal")
  lines                 InventoryTransactionLine[]
  qualityMovements      QualityInventoryMovement[]
  claimSettlements      SupplierClaimSettlement[]  @relation("SettlementInventoryTransaction")

  @@index([type, occurredAt])
  @@index([sourceType, sourceId])
}

model InventoryTransactionLine {
  id               String                     @id @default(uuid()) @db.Uuid
  transactionId    String                     @db.Uuid
  locationId       String                     @db.Uuid
  skuId            String                     @db.Uuid
  stockStatus      InventoryStockStatus
  quantity         Decimal                    @db.Decimal(18, 4)
  unitCost         Decimal                    @db.Decimal(18, 6)
  amount           Decimal                    @db.Decimal(30, 4)
  remark           String?
  transaction      InventoryTransaction       @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  location         InventoryLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sku              Sku                        @relation(fields: [skuId], references: [id], onDelete: Restrict)
  batchAllocations InventoryBatchAllocation[]
  salesIssueItem   SalesIssueItem?

  @@index([locationId, skuId, stockStatus])
  @@index([skuId, transactionId])
}

model InventoryBatch {
  id                    String                     @id @default(uuid()) @db.Uuid
  batchNo               String                     @unique
  skuId                 String                     @db.Uuid
  supplierId            String?                    @db.Uuid
  purchaseReceiptItemId String?                    @unique @db.Uuid
  sourceType            String
  sourceId              String
  receivedQuantity      Decimal                    @db.Decimal(18, 4)
  remainingQuantity     Decimal                    @db.Decimal(18, 4)
  unitCost              Decimal                    @db.Decimal(18, 6)
  receivedAt            DateTime
  createdAt             DateTime                   @default(now())
  sku                   Sku                        @relation(fields: [skuId], references: [id], onDelete: Restrict)
  supplier              Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseReceiptItem   PurchaseReceiptItem?       @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: Restrict)
  allocations           InventoryBatchAllocation[]
  salesReturnTraces     SalesReturnBatchTrace[]

  @@index([skuId, receivedAt])
  @@index([supplierId, receivedAt])
}

model InventoryBatchAllocation {
  id                String                   @id @default(uuid()) @db.Uuid
  batchId           String                   @db.Uuid
  transactionLineId String                   @db.Uuid
  quantity          Decimal                  @db.Decimal(18, 4)
  batch             InventoryBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  transactionLine   InventoryTransactionLine @relation(fields: [transactionLineId], references: [id], onDelete: Restrict)

  @@unique([batchId, transactionLineId])
  @@index([transactionLineId])
}

model InventoryOpening {
  id            String                 @id @default(uuid()) @db.Uuid
  openingNo     String                 @unique
  importKey     String                 @unique
  status        DocumentStatus         @default(DRAFT)
  occurredAt    DateTime
  remark        String?
  postedAt      DateTime?
  transactionId String?                @unique @db.Uuid
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  items         InventoryOpeningItem[]

  @@index([status, occurredAt])
}

model InventoryOpeningItem {
  id          String               @id @default(uuid()) @db.Uuid
  openingId   String               @db.Uuid
  locationId  String               @db.Uuid
  skuId       String               @db.Uuid
  stockStatus InventoryStockStatus @default(AVAILABLE)
  quantity    Decimal              @db.Decimal(18, 4)
  unitCost    Decimal              @db.Decimal(18, 6)
  batchNo     String
  remark      String?
  opening     InventoryOpening     @relation(fields: [openingId], references: [id], onDelete: Restrict)
  location    InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sku         Sku                  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([openingId, locationId, skuId, stockStatus])
}

model InventoryAdjustment {
  id            String                    @id @default(uuid()) @db.Uuid
  adjustmentNo  String                    @unique
  direction     AdjustmentDirection
  status        DocumentStatus            @default(DRAFT)
  occurredAt    DateTime
  reason        String
  postedAt      DateTime?
  transactionId String?                   @unique @db.Uuid
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  items         InventoryAdjustmentItem[]

  @@index([status, occurredAt])
}

model InventoryAdjustmentItem {
  id           String               @id @default(uuid()) @db.Uuid
  adjustmentId String               @db.Uuid
  locationId   String               @db.Uuid
  skuId        String               @db.Uuid
  stockStatus  InventoryStockStatus @default(AVAILABLE)
  quantity     Decimal              @db.Decimal(18, 4)
  unitCost     Decimal?             @db.Decimal(18, 6)
  remark       String?
  adjustment   InventoryAdjustment  @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  location     InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sku          Sku                  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
}

model InventoryTransfer {
  id             String                  @id @default(uuid()) @db.Uuid
  transferNo     String                  @unique
  fromLocationId String                  @db.Uuid
  toLocationId   String                  @db.Uuid
  status         DocumentStatus          @default(DRAFT)
  occurredAt     DateTime
  remark         String?
  postedAt       DateTime?
  transactionId  String?                 @unique @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  fromLocation   InventoryLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     InventoryLocation       @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  items          InventoryTransferItem[]

  @@index([status, occurredAt])
  @@index([fromLocationId, toLocationId])
}

model InventoryTransferItem {
  id          String               @id @default(uuid()) @db.Uuid
  transferId  String               @db.Uuid
  skuId       String               @db.Uuid
  stockStatus InventoryStockStatus @default(AVAILABLE)
  quantity    Decimal              @db.Decimal(18, 4)
  remark      String?
  transfer    InventoryTransfer    @relation(fields: [transferId], references: [id], onDelete: Restrict)
  sku         Sku                  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([transferId])
}

model ChannelAllocation {
  id             String                  @id @default(uuid()) @db.Uuid
  allocationNo   String                  @unique
  salesChannelId String                  @db.Uuid
  locationId     String                  @db.Uuid
  status         DocumentStatus          @default(POSTED)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  salesChannel   SalesChannel            @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  location       InventoryLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items          ChannelAllocationItem[]

  @@index([salesChannelId, locationId])
}

model ChannelAllocationItem {
  id                  String            @id @default(uuid()) @db.Uuid
  channelAllocationId String            @db.Uuid
  skuId               String            @db.Uuid
  quantity            Decimal           @db.Decimal(18, 4)
  consumedQuantity    Decimal           @default(0) @db.Decimal(18, 4)
  channelAllocation   ChannelAllocation @relation(fields: [channelAllocationId], references: [id], onDelete: Restrict)
  sku                 Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([channelAllocationId, skuId])
}

model PurchasePrice {
  id                String           @id @default(uuid()) @db.Uuid
  skuId             String           @db.Uuid
  supplierId        String           @db.Uuid
  buyerId           String?          @db.Uuid
  purchaseChannelId String           @db.Uuid
  currency          String           @default("CNY")
  price             Decimal          @db.Decimal(18, 6)
  minQuantity       Decimal          @default(1) @db.Decimal(18, 4)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            MasterDataStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sku               Sku              @relation(fields: [skuId], references: [id], onDelete: Restrict)
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  buyer             Buyer?           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  purchaseChannel   PurchaseChannel  @relation(fields: [purchaseChannelId], references: [id], onDelete: Restrict)

  @@index([skuId, supplierId, purchaseChannelId, effectiveFrom])
  @@index([buyerId, status, effectiveFrom])
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  orderNo           String              @unique
  supplierId        String              @db.Uuid
  buyerId           String              @db.Uuid
  purchaseChannelId String              @db.Uuid
  currency          String              @default("CNY")
  status            PurchaseOrderStatus @default(DRAFT)
  orderDate         DateTime
  expectedAt        DateTime?
  remark            String?
  totalAmount       Decimal             @db.Decimal(30, 4)
  confirmedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  buyer             Buyer               @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  purchaseChannel   PurchaseChannel     @relation(fields: [purchaseChannelId], references: [id], onDelete: Restrict)
  items             PurchaseOrderItem[]
  receipts          PurchaseReceipt[]

  @@index([supplierId, status, orderDate])
  @@index([purchaseChannelId, buyerId, orderDate])
}

model PurchaseOrderItem {
  id               String                @id @default(uuid()) @db.Uuid
  purchaseOrderId  String                @db.Uuid
  skuId            String                @db.Uuid
  quantity         Decimal               @db.Decimal(18, 4)
  unitPrice        Decimal               @db.Decimal(18, 6)
  lineAmount       Decimal               @db.Decimal(30, 4)
  receivedQuantity Decimal               @default(0) @db.Decimal(18, 4)
  returnedQuantity Decimal               @default(0) @db.Decimal(18, 4)
  remark           String?
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  sku              Sku                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  receiptItems     PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([skuId, purchaseOrderId])
}

model PurchaseReceipt {
  id              String                @id @default(uuid()) @db.Uuid
  receiptNo       String                @unique
  purchaseOrderId String                @db.Uuid
  locationId      String                @db.Uuid
  status          DocumentStatus        @default(DRAFT)
  occurredAt      DateTime
  remark          String?
  totalAmount     Decimal               @db.Decimal(30, 4)
  postedAt        DateTime?
  transactionId   String?               @unique @db.Uuid
  payableId       String?               @unique @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  location        InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items           PurchaseReceiptItem[]
  returns         PurchaseReturn[]
  payable         Payable?              @relation("ReceiptPayable", fields: [payableId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId, status, occurredAt])
  @@index([locationId, occurredAt])
}

model PurchaseReceiptItem {
  id                  String               @id @default(uuid()) @db.Uuid
  purchaseReceiptId   String               @db.Uuid
  purchaseOrderItemId String               @db.Uuid
  skuId               String               @db.Uuid
