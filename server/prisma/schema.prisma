  @@index([accountId, status, occurredAt])
  @@index([supplierId, purchaseChannelId, buyerId, occurredAt])
  @@index([customerId, salesChannelId, occurredAt])
}

model PaymentAllocation {
  id               String          @id @default(uuid()) @db.Uuid
  paymentId        String          @db.Uuid
  payableId        String?         @db.Uuid
  customerRefundId String?         @db.Uuid
  supplierCreditId String?         @db.Uuid
  amount           Decimal         @db.Decimal(30, 4)
  creditAmount     Decimal         @default(0) @db.Decimal(30, 4)
  createdAt        DateTime        @default(now())
  payment          Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payable          Payable?        @relation(fields: [payableId], references: [id], onDelete: Restrict)
  customerRefund   CustomerRefund? @relation(fields: [customerRefundId], references: [id], onDelete: Restrict)
  supplierCredit   SupplierCredit? @relation(fields: [supplierCreditId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([payableId])
  @@index([customerRefundId])
  @@index([supplierCreditId])
}

model Receipt {
  id               String                @id @default(uuid()) @db.Uuid
  receiptNo        String                @unique
  accountId        String                @db.Uuid
  customerId       String?               @db.Uuid
  supplierId       String?               @db.Uuid
  salesChannelId   String?               @db.Uuid
  currency         String                @default("CNY")
  amount           Decimal               @db.Decimal(30, 4)
  status           DocumentStatus        @default(DRAFT)
  occurredAt       DateTime
  settlementPeriod String?
  remark           String?
  transactionId    String?               @unique @db.Uuid
  postedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  account          FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier         Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  salesChannel     SalesChannel?         @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  transaction      FinancialTransaction? @relation("ReceiptTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  allocations      ReceiptAllocation[]

  @@index([accountId, status, occurredAt])
  @@index([customerId, salesChannelId, occurredAt])
  @@index([supplierId, occurredAt])
}

model ReceiptAllocation {
  id                               String                          @id @default(uuid()) @db.Uuid
  receiptId                        String                          @db.Uuid
  receivableId                     String?                         @db.Uuid
  supplierCompensationReceivableId String?                         @db.Uuid
  amount                           Decimal                         @db.Decimal(30, 4)
  createdAt                        DateTime                        @default(now())
  receipt                          Receipt                         @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  receivable                       Receivable?                     @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  supplierCompensationReceivable   SupplierCompensationReceivable? @relation(fields: [supplierCompensationReceivableId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([receivableId])
  @@index([supplierCompensationReceivableId])
}

model AccountAdjustment {
  id                String                       @id @default(uuid()) @db.Uuid
  adjustmentNo      String                       @unique
  accountId         String                       @db.Uuid
  direction         FinancialDirection
  category          FinancialTransactionCategory
  amount            Decimal                      @db.Decimal(30, 4)
  currency          String                       @default("CNY")
  salesChannelId    String?                      @db.Uuid
  customerId        String?                      @db.Uuid
  supplierId        String?                      @db.Uuid
  purchaseChannelId String?                      @db.Uuid
  buyerId           String?                      @db.Uuid
  status            DocumentStatus               @default(DRAFT)
  occurredAt        DateTime
  reason            String
  transactionId     String?                      @unique @db.Uuid
  postedAt          DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  account           FinancialAccount             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  salesChannel      SalesChannel?                @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  customer          Customer?                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier?                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseChannel   PurchaseChannel?             @relation(fields: [purchaseChannelId], references: [id], onDelete: Restrict)
  buyer             Buyer?                       @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  transaction       FinancialTransaction?        @relation("AdjustmentTransaction", fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([accountId, status, occurredAt])
  @@index([category, occurredAt])
}

model FinancialTransaction {
  id                String                       @id @default(uuid()) @db.Uuid
  transactionNo     String                       @unique
  accountId         String                       @db.Uuid
  direction         FinancialDirection
  category          FinancialTransactionCategory
  amount            Decimal                      @db.Decimal(30, 4)
  currency          String                       @default("CNY")
  sourceType        String
  sourceId          String
  salesChannelId    String?                      @db.Uuid
  customerId        String?                      @db.Uuid
  supplierId        String?                      @db.Uuid
  purchaseChannelId String?                      @db.Uuid
  buyerId           String?                      @db.Uuid
  occurredAt        DateTime
  remark            String?
  createdAt         DateTime                     @default(now())
  account           FinancialAccount             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  salesChannel      SalesChannel?                @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  customer          Customer?                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier?                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseChannel   PurchaseChannel?             @relation(fields: [purchaseChannelId], references: [id], onDelete: Restrict)
  buyer             Buyer?                       @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  payment           Payment?                     @relation("PaymentTransaction")
  receipt           Receipt?                     @relation("ReceiptTransaction")
  adjustment        AccountAdjustment?           @relation("AdjustmentTransaction")

  @@unique([sourceType, sourceId])
  @@index([accountId, occurredAt])
  @@index([direction, category, occurredAt])
  @@index([salesChannelId, customerId, occurredAt])
  @@index([supplierId, purchaseChannelId, buyerId, occurredAt])
}

model FileAsset {
  id           String              @id @default(uuid()) @db.Uuid
  provider     StorageProviderType
  driveId      String
  itemId       String
  parentItemId String?
  logicalPath  String
  fileName     String
  mimeType     String
  size         Int
  sha256       String
  eTag         String?
  status       FileAssetStatus     @default(SYNCED)
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  productImage ProductImage?
  associations FileAssociation[]
  backup       BackupHistory?

  @@unique([provider, driveId, itemId])
  @@index([status, createdAt])
  @@index([provider, logicalPath])
  @@index([sha256])
}

model ProductImage {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  fileAssetId String    @unique @db.Uuid
  isPrimary   Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, sortOrder])
  @@index([productId, isPrimary, sortOrder])
}

model FileAssociation {
  id          String    @id @default(uuid()) @db.Uuid
  fileAssetId String    @db.Uuid
  module      String
  entityType  String
  entityId    String
  label       String?
  createdAt   DateTime  @default(now())
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([fileAssetId, module, entityType, entityId])
  @@index([module, entityType, entityId])
}

model BackupHistory {
  id              String        @id @default(uuid()) @db.Uuid
  backupNo        String        @unique
  fileAssetId     String?       @unique @db.Uuid
  createdById     String?       @db.Uuid
  status          BackupStatus  @default(CREATING)
  format          BackupFormat  @default(POSTGRES_CUSTOM)
  trigger         BackupTrigger
  schemaVersion   String
  appVersion      String
  postgresVersion String?
  sha256          String?
  size            BigInt        @default(0)
  manifest        Json?
  locked          Boolean       @default(false)
  localAvailable  Boolean       @default(false)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  verifiedAt      DateTime?
  cloudUploadedAt DateTime?
  restoredAt      DateTime?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  fileAsset       FileAsset?    @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  createdBy       AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([trigger, startedAt])
  @@index([locked, completedAt])
}
