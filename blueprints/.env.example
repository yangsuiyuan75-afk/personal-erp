# Application
NODE_ENV=development
APP_PORT=3000
WEB_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=personal_erp
POSTGRES_USER=personal_erp
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://personal_erp:change-me@localhost:5432/personal_erp?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-with-a-long-random-value
JWT_REFRESH_SECRET=change-me-with-another-long-random-value

# Microsoft Graph / OneDrive Personal
MICROSOFT_CLIENT_ID=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/consumers
ONEDRIVE_ROOT_FOLDER=ERP_STORAGE

# Backup
BACKUP_AUTO_AFTER_HOURS=24
BACKUP_OPERATION_THRESHOLD=50
BACKUP_TEMP_DIR=
PG_DUMP_PATH=
PG_RESTORE_PATH=

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api/v1
