# Application
NODE_ENV=development
APP_PORT=3000
WEB_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=personal_erp
POSTGRES_USER=personal_erp
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgresql://personal_erp:change-me@localhost:5432/personal_erp?schema=public
TEST_DATABASE_URL=postgresql://personal_erp_test:personal_erp_test@localhost:5433/personal_erp_test?schema=public

# Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# Microsoft Graph / OneDrive Personal
MICROSOFT_CLIENT_ID=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/consumers
ONEDRIVE_ROOT_FOLDER=ERP_STORAGE
# 模拟 Provider 的本地目录；留空时使用应用的 .data/files（测试环境使用系统临时目录）
FILE_STORAGE_DIR=

# Backup
BACKUP_AUTO_AFTER_HOURS=24
BACKUP_OPERATION_THRESHOLD=50
BACKUP_TEMP_DIR=
PG_DUMP_PATH=
PG_RESTORE_PATH=
# 使用 Docker PostgreSQL 时的容器名；自定义 Compose 名称时修改
POSTGRES_CONTAINER_NAME=personal-erp-postgres
POSTGRES_TEST_CONTAINER_NAME=personal-erp-postgres-test
# 仅用于数据库无 Schema/无管理员时的 Bootstrap 恢复，至少 16 字符
BOOTSTRAP_RECOVERY_KEY=replace-with-a-local-recovery-key
